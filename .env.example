# Copy to .env and supply a fresh key. Never put credentials into page descriptions.
OPENROUTER_API_KEY=
HARNESS_PORT=8787
HARNESS_ASSETS=none
HARNESS_IMAGE_MODEL=openai/gpt-5-image
HARNESS_MAX_ASSETS_PER_RUN=4
HARNESS_MAX_STEPS=8
# A wall-clock deadline, not a token cap; raise for slow reasoning/image models.
HARNESS_RUN_TIMEOUT_MS=600000
